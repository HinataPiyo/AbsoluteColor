.adjust .unity-base-slider__tracker {
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    position: relative;
    top: 0%;
    min-height: 30px;
    height: 60px;
}

.adjust .unity-base-slider__dragger {
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    top: 0%;
    width: 15px;
    min-height: 30px;
    height: 60px;
}
