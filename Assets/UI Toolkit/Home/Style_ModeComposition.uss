:root {
}

.hight-score-text {
    -unity-font-definition: url("project://database/Assets/Fonts/YuseiMagic-Regular.ttf?fileID=12800000&guid=8dc6deb8c7626c644b886806e8b2f960&type=3#YuseiMagic-Regular");
    font-size: 46px;
}

.button {
    background-color: rgb(255, 207, 184);
}

.button:hover {
    background-color: rgb(255, 148, 148);
    scale: 1.02 1.02;
}

.button:active {
    scale: 0.98 0.98;
}
