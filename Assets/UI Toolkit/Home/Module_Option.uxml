<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Template name="Temp_BackButton" src="project://database/Assets/UI%20Toolkit/Temp_BackButton.uxml?fileID=9197481963319205126&amp;guid=f516b7b6ca282c441b50fe7235cf37ca&amp;type=3#Temp_BackButton"/>
    <Style src="project://database/Assets/UI%20Toolkit/Home/Style_Option.uss?fileID=7433441132597879392&amp;guid=fdb3d05ea4ee51747b9c0b2b775b293e&amp;type=3#Style_Option"/>
    <ui:VisualElement name="root" style="background-color: rgb(255, 196, 138); border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-left-color: rgb(238, 48, 48); border-right-color: rgb(238, 48, 48); border-top-color: rgb(238, 48, 48); border-bottom-color: rgb(238, 48, 48); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; padding-top: 0; padding-right: 20px; padding-bottom: 20px; padding-left: 20px;">
        <ui:Label text="音量調整" name="adjust-audio-text" style="-unity-text-align: middle-center; -unity-font-definition: url(&quot;project://database/Assets/Fonts/YuseiMagic-Regular.ttf?fileID=12800000&amp;guid=8dc6deb8c7626c644b886806e8b2f960&amp;type=3#YuseiMagic-Regular&quot;); font-size: 64px;"/>
        <ui:VisualElement name="adjust-bgm" style="flex-grow: 1;">
            <ui:Label text="BGM" name="adjust-bgm-text" class="option-text"/>
            <ui:Slider value="42" high-value="100" style="min-height: auto;"/>
        </ui:VisualElement>
        <ui:VisualElement name="adjust-se" style="flex-grow: 1;">
            <ui:Label text="SE" name="adjust-bgm-text" class="option-text"/>
            <ui:Slider value="42" high-value="100" style="min-height: auto;"/>
        </ui:VisualElement>
        <ui:Instance template="Temp_BackButton" name="BackButton" style="padding-top: 100px; padding-right: 17px; padding-bottom: 17px; padding-left: 17px;"/>
    </ui:VisualElement>
</ui:UXML>
