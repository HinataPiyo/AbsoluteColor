<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Template name="Module_ColorPreviewEditPanel" src="project://database/Assets/UI%20Toolkit/Home/Module_ColorPreviewEditPanel.uxml?fileID=9197481963319205126&amp;guid=ec7b88b38d301894e8d5f9198c2b90d5&amp;type=3#Module_ColorPreviewEditPanel"/>
    <ui:Template name="Module_Option" src="project://database/Assets/UI%20Toolkit/Home/Module_Option.uxml?fileID=9197481963319205126&amp;guid=f8131a840e797b04cafa13ef91805beb&amp;type=3#Module_Option"/>
    <ui:Template name="Module_ScoreHistory" src="project://database/Assets/UI%20Toolkit/Home/Module_ScoreHistory.uxml?fileID=9197481963319205126&amp;guid=2b0bc69b3c6565d48a57a5f59dbea7d0&amp;type=3#Module_ScoreHistory"/>
    <ui:Template name="Module_SelectModePanel" src="project://database/Assets/UI%20Toolkit/Home/Module_SelectModePanel.uxml?fileID=9197481963319205126&amp;guid=ec29c790568b1f9409bbb16d09be8db3&amp;type=3#Module_SelectModePanel"/>
    <ui:Template name="Module_VariousButtons" src="project://database/Assets/UI%20Toolkit/Home/Module_VariousButtons.uxml?fileID=9197481963319205126&amp;guid=cbdb6a74d7ad59948bd349944656d723&amp;type=3#Module_VariousButtons"/>
    <Style src="project://database/Assets/UI%20Toolkit/Home/Style_ColorEditButtons.uss?fileID=7433441132597879392&amp;guid=f3f299f607a22484f9a806b7faf527d8&amp;type=3#Style_ColorEditButtons"/>
    <ui:VisualElement name="root" style="flex-grow: 1;">
        <ui:VisualElement name="upper-area" style="flex-grow: 1; height: 0%;">
            <ui:VisualElement name="player-information-box" style="position: absolute; top: 5%; left: 5%; width: 40%; flex-direction: row; align-items: center; display: none;">
                <ui:VisualElement name="icon" style="background-color: rgb(255, 255, 255); border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); border-top-width: 3px; border-right-width: 3px; border-bottom-width: 3px; border-left-width: 3px; border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; overflow: hidden; width: 140px; height: 140px;"/>
                <ui:VisualElement name="vertical-container" style="margin-top: 0; flex-grow: 1;">
                    <ui:VisualElement name="title-box" style="background-color: rgb(168, 168, 168); border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); border-top-left-radius: 0; border-top-right-radius: 20px; border-bottom-right-radius: 0; border-bottom-left-radius: 0; border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 0; justify-content: center;">
                        <ui:Label text="称号" name="title-value" style="-unity-font-definition: url(&quot;project://database/Assets/Fonts/YuseiMagic-Regular.ttf?fileID=12800000&amp;guid=8dc6deb8c7626c644b886806e8b2f960&amp;type=3#YuseiMagic-Regular&quot;); font-size: 28px; -unity-text-align: middle-left; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="usename-box" style="background-color: rgb(207, 207, 207); border-top-width: 0; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 0; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); border-top-right-radius: 0; border-bottom-right-radius: 20px; justify-content: center;">
                        <ui:Label text="ユーザーネーム" name="usename-value" style="-unity-font-definition: url(&quot;project://database/Assets/Fonts/YuseiMagic-Regular.ttf?fileID=12800000&amp;guid=8dc6deb8c7626c644b886806e8b2f960&amp;type=3#YuseiMagic-Regular&quot;); font-size: 36px; -unity-text-align: middle-left; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="color-preview" style="border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); border-top-width: 3px; border-right-width: 3px; border-bottom-width: 3px; border-left-width: 3px; border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; width: 40%; align-self: center; height: 10%; background-color: rgb(255, 78, 78); position: absolute; top: 25%;">
                <ui:Label text="プレビュー" name="preview-text" style="top: -50%; position: relative; -unity-font-definition: url(&quot;project://database/Assets/Fonts/YuseiMagic-Regular.ttf?fileID=12800000&amp;guid=8dc6deb8c7626c644b886806e8b2f960&amp;type=3#YuseiMagic-Regular&quot;); font-size: 26px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;"/>
            </ui:VisualElement>
            <ui:Button text="オプション" name="button-option" style="font-size: 32px; -unity-font-definition: url(&quot;project://database/Assets/Fonts/YuseiMagic-Regular.ttf?fileID=12800000&amp;guid=8dc6deb8c7626c644b886806e8b2f960&amp;type=3#YuseiMagic-Regular&quot;); position: absolute; right: 5%; top: 8%; width: 150px;"/>
            <ui:Button text="ヘルプ" name="button-help" style="font-size: 32px; -unity-font-definition: url(&quot;project://database/Assets/Fonts/YuseiMagic-Regular.ttf?fileID=12800000&amp;guid=8dc6deb8c7626c644b886806e8b2f960&amp;type=3#YuseiMagic-Regular&quot;); position: absolute; right: 23%; top: 8%; width: 150px; display: none;"/>
            <ui:VisualElement name="color-edit-buttons" style="right: 5%; bottom: 5%; position: absolute; flex-direction: column-reverse; align-items: stretch; width: 18%; height: 55%;">
                <ui:Button text="RGB" name="button-edit-rgb" class="color-edit-buttons"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="bottom-area" style="height: 42%; background-color: rgb(255, 234, 220); border-left-color: rgb(248, 177, 134); border-right-color: rgb(248, 177, 134); border-top-color: rgb(248, 177, 134); border-bottom-color: rgb(248, 177, 134); border-top-width: 3px; border-right-width: 3px; border-bottom-width: 3px; border-left-width: 3px; border-top-left-radius: 15px; border-top-right-radius: 15px; border-bottom-right-radius: 15px; border-bottom-left-radius: 15px; justify-content: center;">
            <ui:Instance template="Module_VariousButtons" name="VariousButtons" style="flex-grow: 1; display: flex;"/>
            <ui:Instance template="Module_ColorPreviewEditPanel" name="ColorPreviewEditPanel" style="display: none;"/>
        </ui:VisualElement>
        <ui:VisualElement name="all-area" picking-mode="Ignore" style="position: absolute; height: 90%; width: 100%; justify-content: center;">
            <ui:Instance template="Module_SelectModePanel" name="SelectModePanel" style="flex-grow: 1; display: none;"/>
            <ui:Instance template="Module_ScoreHistory" name="ScoreHistoryPanel" style="display: none; flex-grow: 1;"/>
            <ui:Instance template="Module_Option" name="Option" style="width: 50%; align-self: center; display: none;"/>
        </ui:VisualElement>
        <ui:VisualElement name="Ads" style="height: 10%;"/>
    </ui:VisualElement>
</ui:UXML>
