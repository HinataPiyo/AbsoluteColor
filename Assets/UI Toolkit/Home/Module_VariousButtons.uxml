<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/Home/Style_VariousButtons.uss?fileID=7433441132597879392&amp;guid=1c2572b71116e8144960ae8e7d422f92&amp;type=3#Style_VariousButtons"/>
    <ui:VisualElement name="root" style="flex-grow: 1; border-top-width: 3px; border-right-width: 3px; border-bottom-width: 3px; border-left-width: 3px; border-left-color: rgb(248, 177, 134); border-right-color: rgb(248, 177, 134); border-top-color: rgb(248, 177, 134); border-bottom-color: rgb(248, 177, 134); border-top-left-radius: 15px; border-top-right-radius: 15px; border-bottom-right-radius: 15px; border-bottom-left-radius: 15px; background-color: rgb(255, 234, 220); padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 10px;">
        <ui:Button name="button-select-mode" class="buttons" style="height: 15%; margin-left: 10px; margin-right: 10px; align-self: center; width: 50%; margin-top: 10px; margin-bottom: 10px;">
            <ui:Label text="モード: RGB" name="selected-mode-text" picking-mode="Ignore" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;"/>
            <ui:VisualElement name="side-container" picking-mode="Ignore" style="flex-grow: 1; flex-direction: row; justify-content: space-between; padding-left: 20px; padding-right: 20px;">
                <ui:Label text="ハイスコア" name="hight-score-text" picking-mode="Ignore" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; font-size: 26px; -unity-text-align: middle-left;"/>
                <ui:Label text="20,200" name="hight-score-value" picking-mode="Ignore" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; font-size: 26px; -unity-text-align: middle-right;"/>
            </ui:VisualElement>
        </ui:Button>
        <ui:Button text="プレイ" name="button-play" class="buttons" style="height: 30%; align-self: center; width: 70%;"/>
        <ui:VisualElement name="side-container" style="flex-grow: 1; flex-direction: row; justify-content: center;">
            <ui:Button text="コレクション" name="button-collection" class="buttons" style="flex-grow: 1;"/>
            <ui:Button text="イベント" name="button-event" class="buttons" style="flex-grow: 1;"/>
        </ui:VisualElement>
        <ui:VisualElement name="side-container" style="flex-grow: 1; flex-direction: row;">
            <ui:Button text="ランキング" name="button-ranking" class="buttons" style="flex-grow: 1;"/>
            <ui:Button text="スコア履歴" name="button-score-history" class="buttons" style="flex-grow: 1;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
