:root {
}

#button-next-round {
    display: none;
}

.allround-result .score-text {
    font-size: 46px;
    -unity-font-definition: url("project://database/Assets/Fonts/FunnelSans-SemiBold.ttf?fileID=12800000&guid=fc3d7703027d6024e8d901155a459c7e&type=3#FunnelSans-SemiBold");
    -unity-text-outline-width: 3px;
}

.allround-result .round-count-text {
    font-size: 30px;
    -unity-text-align: middle-center;
}

.total-score-text {
    font-size: 92px;
    -unity-font-style: bold-and-italic;
    color: rgb(255, 213, 0);
    -unity-text-outline-color: rgb(255, 45, 51);
    -unity-text-outline-width: 3px;
    -unity-font-definition: url("project://database/Assets/Fonts/YuseiMagic-Regular.ttf?fileID=12800000&guid=8dc6deb8c7626c644b886806e8b2f960&type=3#YuseiMagic-Regular");
}

.score-rank {
    font-size: 72px;
    -unity-font-style: bold-and-italic;
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(58, 0, 255);
    -unity-font-definition: url("project://database/Assets/Fonts/YuseiMagic-Regular.ttf?fileID=12800000&guid=8dc6deb8c7626c644b886806e8b2f960&type=3#YuseiMagic-Regular");
    -unity-text-align: middle-center;
}

.button {
    font-size: 48px;
    -unity-text-align: middle-center;
    min-height: 5%;
    margin-top: 10px;
    margin-right: 10px;
    margin-bottom: 10px;
    margin-left: 10px;
    border-top-left-radius: 11px;
    border-top-right-radius: 11px;
    border-bottom-right-radius: 11px;
    border-bottom-left-radius: 11px;
    flex-grow: 1;
    -unity-font-definition: url("project://database/Assets/Fonts/YuseiMagic-Regular.ttf?fileID=12800000&guid=8dc6deb8c7626c644b886806e8b2f960&type=3#YuseiMagic-Regular");
    width: 0%;
}

.allround-result .judgement-text {
    font-size: 82px;
    margin-left: 15px;
}

.show-panel {
    opacity: 1;
    transition-duration: 0.5s, 0.5s, 0.5s;
    scale: 1 1;
    translate: 0 0;
    transition-timing-function: ease-out-bounce, ease-in-out, ease-out-bounce;
    transition-property: translate, opacity, scale;
    transition-delay: 0.3s, 0s, 0.3s;
}

.hide-panel {
    opacity: 0;
    display: none;
    scale: 1.5 1.5;
    translate: 0 -200px;
    transition-duration: 0.2s;
    transition-timing-function: ease-out;
}
