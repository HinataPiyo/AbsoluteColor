.unity-base-slider__tracker {
    min-height: 80%;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    -unity-material: url("project://database/Assets/Materials/Mat_R.mat?fileID=2100000&guid=b10694c5847060748bb1dc01506fcf5b&type=2#Mat_R") prop("_ChannelMask" 1 0 0 0);
    top: 10%;
}

.unity-slider__label {
    font-size: 62px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    width: 10%;
    min-width: auto;
    overflow: visible;
    margin-right: 10px;
    -unity-font-definition: url("project://database/Assets/Fonts/FunnelSans-SemiBold.ttf?fileID=12800000&guid=fc3d7703027d6024e8d901155a459c7e&type=3#FunnelSans-SemiBold");
}

.unity-base-slider__dragger {
    top: 10%;
    position: relative;
    min-height: 80%;
    width: 1%;
    min-width: auto;
    margin-top: 0;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    border-bottom-left-radius: 8px;
    background-color: rgb(255, 255, 255);
}

.unity-base-field__input {
}

.preview-parameter {
    font-size: 52px;
    -unity-text-align: middle-left;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 10px;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    -unity-font-definition: url("project://database/Assets/Fonts/FunnelSans-SemiBold.ttf?fileID=12800000&guid=fc3d7703027d6024e8d901155a459c7e&type=3#FunnelSans-SemiBold");
}
