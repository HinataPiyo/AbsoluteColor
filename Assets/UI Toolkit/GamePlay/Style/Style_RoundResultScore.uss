:root {
}

.difference-range-text {
    font-size: 42px;
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/Fonts/FunnelSans-SemiBold.ttf?fileID=12800000&guid=fc3d7703027d6024e8d901155a459c7e&type=3#FunnelSans-SemiBold");
}

#parameter {
    font-size: 40px;
    padding-left: 17px;
}

.result .unity-base-slider__label {
    font-size: 34px;
}

.score-text {
    -unity-font-style: bold-and-italic;
    font-size: 92px;
    -unity-text-align: middle-left;
    color: rgb(255, 235, 0);
    -unity-text-outline-color: rgb(255, 0, 0);
    -unity-text-outline-width: 2px;
    -unity-font-definition: url("project://database/Assets/Fonts/YuseiMagic-Regular.ttf?fileID=12800000&guid=8dc6deb8c7626c644b886806e8b2f960&type=3#YuseiMagic-Regular");
}

.round-count-text {
    font-size: 52px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    -unity-font-definition: url("project://database/Assets/Fonts/YuseiMagic-Regular.ttf?fileID=12800000&guid=8dc6deb8c7626c644b886806e8b2f960&type=3#YuseiMagic-Regular");
}

.judgement-text {
    -unity-font-definition: url("project://database/Assets/Fonts/Playball-Regular.ttf?fileID=12800000&guid=c0c3d2cecd4f10f438065affce0d3657&type=3#Playball-Regular");
    font-size: 96px;
    -unity-text-align: middle-center;
}



.show-panel {
    opacity: 1;
    transition-duration: 0.2s;
    scale: 1 1;
    translate: 0 0;
    transition-timing-function: ease-out;
}

.hide-panel {
    opacity: 0;
    display: none;
    scale: 1.5 1.5;
    translate: 0 -200px;
    transition-duration: 0.2s;
    transition-timing-function: ease-out;
}
