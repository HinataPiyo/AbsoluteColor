<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Template name="Temp_AdjustColorSlider" src="project://database/Assets/UI%20Toolkit/Temp_AdjustColorSlider.uxml?fileID=9197481963319205126&amp;guid=be99ea6ebb98c844ca3965056fd4e029&amp;type=3#Temp_AdjustColorSlider"/>
    <ui:VisualElement name="root" style="flex-grow: 1; border-top-width: 3px; border-right-width: 3px; border-bottom-width: 3px; border-left-width: 3px; border-left-color: rgb(93, 34, 0); border-right-color: rgb(93, 34, 0); border-top-color: rgb(93, 34, 0); border-bottom-color: rgb(93, 34, 0); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; background-color: rgb(255, 224, 195); align-items: center; padding-top: 20px; padding-right: 20px; padding-bottom: 20px; padding-left: 20px; justify-content: space-between;">
        <ui:Label text="現在の色" name="preview-color-text" style="font-size: 42px; -unity-text-align: middle-center; margin-top: 0; -unity-font-definition: url(&quot;project://database/Assets/Fonts/YuseiMagic-Regular.ttf?fileID=12800000&amp;guid=8dc6deb8c7626c644b886806e8b2f960&amp;type=3#YuseiMagic-Regular&quot;);"/>
        <ui:VisualElement name="preview-color" style="background-color: rgb(205, 69, 69); width: 80%; height: 15%; border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); margin-top: 10px; margin-right: 10px; margin-bottom: 10px; margin-left: 10px; border-top-left-radius: 20px; border-top-right-radius: 20px; border-bottom-right-radius: 20px; border-bottom-left-radius: 20px;"/>
        <ui:Label text="色調整" name="change-rgb-text" style="font-size: 32px; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; bottom: -21px; -unity-font-definition: url(&quot;project://database/Assets/Fonts/YuseiMagic-Regular.ttf?fileID=12800000&amp;guid=8dc6deb8c7626c644b886806e8b2f960&amp;type=3#YuseiMagic-Regular&quot;);"/>
        <ui:VisualElement name="adjust-color-sliders" style="width: 100%; padding-top: 12px; padding-right: 12px; padding-bottom: 12px; padding-left: 12px; justify-content: space-between; height: 55%; margin-bottom: 30px;">
            <ui:Instance template="Temp_AdjustColorSlider"/>
            <ui:Instance template="Temp_AdjustColorSlider"/>
            <ui:Instance template="Temp_AdjustColorSlider"/>
        </ui:VisualElement>
        <ui:Button text="決定" name="decide-button" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; font-size: 42px; border-top-left-radius: 21px; border-top-right-radius: 21px; border-bottom-right-radius: 21px; border-bottom-left-radius: 21px; padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 10px; -unity-font-style: bold; align-self: center; width: 50%; -unity-font-definition: url(&quot;project://database/Assets/Fonts/YuseiMagic-Regular.ttf?fileID=12800000&amp;guid=8dc6deb8c7626c644b886806e8b2f960&amp;type=3#YuseiMagic-Regular&quot;);"/>
    </ui:VisualElement>
</ui:UXML>
