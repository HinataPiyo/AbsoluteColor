<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Template name="Module_AdjustColorArea" src="project://database/Assets/UI%20Toolkit/GamePlay/Module_AdjustColorArea.uxml?fileID=9197481963319205126&amp;guid=a280ac9e5dbfaa2429e3e8d8b0238e88&amp;type=3#Module_AdjustColorArea"/>
    <ui:Template name="Module_AllRoundResultScore" src="project://database/Assets/UI%20Toolkit/GamePlay/Module_AllRoundResultScore.uxml?fileID=9197481963319205126&amp;guid=72eaacc60f20e2f4cacf2ae310646582&amp;type=3#Module_AllRoundResultScore"/>
    <ui:Template name="Module_RoundResultScore" src="project://database/Assets/UI%20Toolkit/GamePlay/Module_RoundResultScore.uxml?fileID=9197481963319205126&amp;guid=e906f17d63dae1140961bbcaf72e4003&amp;type=3#Module_RoundResultScore"/>
    <ui:VisualElement name="root" style="flex-grow: 1; flex-direction: column-reverse; padding-bottom: 150px;">
        <ui:Instance template="Module_AdjustColorArea" name="AdjustColorArea" style="height: 45%;"/>
        <ui:VisualElement name="TopicPreviewArea" style="flex-grow: 1; margin-top: 40px;">
            <ui:Label text="MaxScore: 2000" name="max-score" style="font-size: 42px; -unity-text-align: middle-center; -unity-font-definition: url(&quot;project://database/Assets/Fonts/YuseiMagic-Regular.ttf?fileID=12800000&amp;guid=8dc6deb8c7626c644b886806e8b2f960&amp;type=3#YuseiMagic-Regular&quot;); margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;"/>
            <ui:Label text="ラウンド1" name="round-count" style="font-size: 80px; -unity-text-align: middle-center; -unity-font-style: bold; -unity-font-definition: url(&quot;project://database/Assets/Fonts/YuseiMagic-Regular.ttf?fileID=12800000&amp;guid=8dc6deb8c7626c644b886806e8b2f960&amp;type=3#YuseiMagic-Regular&quot;); margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;"/>
            <ui:Label text="time: 10s" name="timer" style="font-size: 62px; -unity-text-align: middle-center; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; -unity-font-definition: url(&quot;project://database/Assets/Fonts/YuseiMagic-Regular.ttf?fileID=12800000&amp;guid=8dc6deb8c7626c644b886806e8b2f960&amp;type=3#YuseiMagic-Regular&quot;); padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;"/>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="result-root" style="position: absolute; width: 100%; height: 100%; justify-content: center; align-items: center; display: flex;">
        <ui:Instance template="Module_RoundResultScore" name="RoundResultScore" style="width: 80%; display: none;"/>
        <ui:Instance template="Module_AllRoundResultScore" name="AllRoundResultScore" style="width: 80%; display: none; height: 65%;"/>
    </ui:VisualElement>
</ui:UXML>
